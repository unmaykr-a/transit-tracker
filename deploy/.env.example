# Copy to .env next to docker-compose.yml. Never commit the real file.

# Seeds the first admin on an empty database (otherwise the /setup wizard runs).
BUS_ADMIN_USER=admin
BUS_ADMIN_PASSWORD=change-me

# Optional: debug | info | warn | error (default info)
# BUS_LOG_LEVEL=info

# Optional: who may scrape /metrics — private (default: loopback and private networks), public or off.
# BUS_METRICS=private
# Optional: require this bearer token for /metrics instead of the network check.
# BUS_METRICS_TOKEN=

# Optional OIDC (Authentik) is planned but not implemented yet.
# BUS_OIDC_ISSUER=https://auth.taali.ee/application/o/bus/
# BUS_OIDC_CLIENT_ID=
# BUS_OIDC_CLIENT_SECRET=
# BUS_OIDC_ADMIN_GROUP=bus-admins
