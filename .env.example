# Copy to .env next to docker-compose.yml. Never commit the real file.

# Seeds the first admin on an empty database (otherwise the /setup wizard runs).
TRAM_ADMIN_USER=admin
TRAM_ADMIN_PASSWORD=change-me

# 32+ random bytes, e.g. `openssl rand -base64 48`.
TRAM_SESSION_SECRET=

# Optional: debug | info | warn | error (default info)
# TRAM_LOG_LEVEL=info

# Optional OIDC (Authentik), from M3 onward.
# TRAM_OIDC_ISSUER=https://auth.taali.ee/application/o/tram/
# TRAM_OIDC_CLIENT_ID=
# TRAM_OIDC_CLIENT_SECRET=
# TRAM_OIDC_ADMIN_GROUP=tram-admins
