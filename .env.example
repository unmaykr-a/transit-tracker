# Copy to .env next to docker-compose.yml. Never commit the real file.

# Seeds the first admin on an empty database (otherwise the /setup wizard runs).
BUS_ADMIN_USER=admin
BUS_ADMIN_PASSWORD=change-me

# Optional: debug | info | warn | error (default info)
# BUS_LOG_LEVEL=info

# Optional single sign-on (OpenID Connect; tested with Authentik). Needs BUS_BASE_URL: register
# <BUS_BASE_URL>/api/v1/auth/oidc/callback as the redirect URI at the provider.
# BUS_OIDC_ISSUER=https://auth.taali.ee/application/o/bus/
# BUS_OIDC_CLIENT_ID=
# BUS_OIDC_CLIENT_SECRET=
# Members of this group (the "groups" claim) are admins; others are users.
# BUS_OIDC_ADMIN_GROUP=bus-admins
# Button label: "Sign in with <name>".
# BUS_OIDC_NAME=Authentik
# Create accounts on first sign-in (default true); false = only people who have signed in before.
# BUS_OIDC_AUTO_CREATE=true
